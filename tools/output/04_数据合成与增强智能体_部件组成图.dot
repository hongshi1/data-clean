graph claw {
  graph [overlap=false, splines=true, fontname="Heiti SC", size="6,4", dpi=150, bgcolor="white"];
  node [shape=box, fontname="Heiti SC"];
  center [label="数据合成与增强智能体", style=filled, fillcolor=lightyellow, fontsize=13, width=2.2, height=0.8];
  p0 [label="数据合成", fontsize=11, width=1.9, height=0.7];
  center -- p0;
  p1 [label="样本增强", fontsize=11, width=1.9, height=0.7];
  center -- p1;
  p2 [label="类别均衡", fontsize=11, width=1.9, height=0.7];
  center -- p2;
}