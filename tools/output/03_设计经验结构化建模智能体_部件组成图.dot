graph claw {
  graph [overlap=false, splines=true, fontname="Heiti SC", size="6,4", dpi=150, bgcolor="white"];
  node [shape=box, fontname="Heiti SC"];
  center [label="设计经验结构化建模智能体", style=filled, fillcolor=lightyellow, fontsize=13, width=2.2, height=0.8];
  p0 [label="经验知识抽取", fontsize=11, width=1.9, height=0.7];
  center -- p0;
  p1 [label="知识形式化", fontsize=11, width=1.9, height=0.7];
  center -- p1;
  p2 [label="知识图谱构建", fontsize=11, width=1.9, height=0.7];
  center -- p2;
}