  center -> p0;
  p0_c0 [label="规则逻辑推导", fillcolor=white, fontsize=10, width=1.6, height=0.5];
  p0 -> p0_c0;
  p0_c1 [label="结构模式识别", fillcolor=white, fontsize=10, width=1.6, height=0.5];
  p0 -> p0_c1;
  p1 [label="语义层校验", fillcolor=lightcyan, fontsize=12, width=1.8, height=0.6];
  center -> p1;
  p1_c0 [label="跨模态语义校验", fillcolor=white, fontsize=10, width=1.6, height=0.5];
  p1 -> p1_c0;
  p1_c1 [label="蕴含矛盾判定", fillcolor=white, fontsize=10, width=1.6, height=0.5];
