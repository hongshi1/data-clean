  p2 [label="逻辑层校验", fillcolor=lightcyan, fontsize=12, width=1.8, height=0.6];
  center -> p2;
  p2_c0 [label="约束求解分析", fillcolor=white, fontsize=10, width=1.6, height=0.5];
