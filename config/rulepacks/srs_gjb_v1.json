{
  "pack_id": "srs_gjb_v1",
  "description": "GJB 438C SRS默认规则包(04号数据统一访问服务形态): 从L1专家硬编码逐项迁移(对照源码, 不增不减); 表格签名/列映射/模板正则/词表/窗口/阈值",
  "gjb_rule_library_path": "knowledge/gjb_438c_rules_full.json",
  "table_schemas": {
    "capability_table": {
      "signatures": [
        {
          "all_headers": [
            "项目唯一标识符",
            "需求描述"
          ]
        }
      ],
      "canon_map": {
        "Usecase名称": "Use case名称",
        "UseCase名称": "Use case名称",
        "USECASE名称": "Use case名称",
        "对应的任务书功能/性能": "对应任务书"
      },
      "key_columns": [
        "Use case名称",
        "项目唯一标识符"
      ],
      "column_profiles": {
        "identifier": [
          "Use case名称",
          "项目唯一标识符"
        ],
        "enumeration": [
          "Use case名称",
          "方式名称",
          "运行状态"
        ],
        "default": [
          "Use case名称",
          "项目唯一标识符",
          "需求描述"
        ]
      }
    },
    "use_case_table": {
      "signatures": [
        {
          "raw_regex": "Use\\s*[Cc]ase\\s*名称\\s*[：:]"
        },
        {
          "raw_contains_any": [
            "主事件流",
            "后置条件"
          ]
        }
      ],
      "columns": [
        "Use Case名称",
        "Actors",
        "概述",
        "前置条件",
        "主事件流",
        "异常流E1",
        "后置条件"
      ],
      "flow_subcolumns": [
        "Actor动作",
        "系统动作",
        "动作约束"
      ],
      "use_case_fields": {
        "name_pattern": "^Use\\s*[Cc]ase\\s*名称\\s*[：:]\\s*(?P<name>.+)$",
        "actors_pattern": "^Actors?\\s*[：:]\\s*(?P<actors>.+)$",
        "field_pattern": "^(?P<field>Use\\s*[Cc]ase\\s*名称|Actors?|简要说明|概述|前置条件|后置条件|异常流E\\d+)\\s*[：:]\\s*(?P<value>.*)$",
        "flow_header_pattern": "^主事件流",
        "subheader_pattern": "^Actor\\s*的动作",
        "field_canon": {
          "简要说明": "概述"
        }
      }
    },
    "interface_table": {
      "signatures": [
        {
          "any_header_groups": [
            [
              "接口需求标识"
            ]
          ]
        },
        {
          "all_headers": [
            "发送方",
            "接收方"
          ]
        }
      ],
      "key_columns": [
        "接口需求名称",
        "接口需求标识"
      ],
      "column_profiles": {
        "identifier": [
          "接口需求名称",
          "接口需求标识"
        ],
        "enumeration": [
          "接口需求名称",
          "接口内容"
        ],
        "default": [
          "接口需求名称",
          "接口需求标识",
          "接口内容",
          "发送方",
          "接收方"
        ]
      }
    },
    "value_domain_table": {
      "signatures": [
        {
          "all_headers": [
            "数据项"
          ],
          "any_header_groups": [
            [
              "最大值",
              "最大差",
              "最小值",
              "最小差"
            ],
            [
              "精度",
              "单位"
            ]
          ]
        }
      ],
      "canon_map": {
        "最大差": "最大值",
        "最小差": "最小值"
      },
      "key_columns": [
        "数据项"
      ],
      "column_profiles": {
        "default": [
          "数据项",
          "最大值",
          "最小值",
          "精度",
          "单位"
        ]
      }
    },
    "qualification_table": {
      "signatures": [
        {
          "any_header_groups": [
            [
              "合格性方法",
              "合格性级别"
            ]
          ]
        }
      ],
      "canon_map": {
        "需求名称/标识": "需求名称标识",
        "本文档的章节号": "章节号",
        "合格性方法": "合格性方法",
        "合格性级别": "合格性级别"
      },
      "key_columns": [
        "需求名称标识"
      ],
      "column_profiles": {
