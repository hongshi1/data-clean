  "join_params": {
    "e1": {
      "trim_edges": " \n\t。，,；;：:“”\"'"
    },
    "id_join": {
      "id_window": 32,
      "family_segments": 2,
      "subject_contain_min_chars": 3,
      "segment_edge_strip": " -—-*_`#>|·"
    },
    "enum_join": {
      "typo_distance": 1,
