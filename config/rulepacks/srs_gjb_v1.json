          ]
        },
        {
          "any_header_substring_groups": [
            [
              "章节号"
            ],
            [
              "名称/标识",
              "名称标识"
            ]
          ]
        }
      ],
      "canon_map": {
        "软件研制任务书名称/标识": "任务书名称标识",
        "软件研制任务书的章节号": "任务书章节号",
        "本文档的名称/标识": "本文档名称标识",
        "本文档的章节号": "本文档章节号",
        "跟踪说明": "跟踪说明"
      },
      "column_profiles": {
        "default": [
          "任务书名称标识",
          "任务书章节号",
          "本文档名称标识",
          "本文档章节号",
          "跟踪说明"
        ]
      },
      "direction_first_column_prefix": "任务书",
      "direction_markers": [
        "任务书",
        "本文档"
      ],
      "trace_key_columns": {
        "forward": [
          "任务书名称标识",
          "本文档名称标识"
        ],
        "reverse": [
          "本文档名称标识",
