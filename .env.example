# API密钥模板: 复制为.env并填入真实值(.env已gitignore, 不提交)
# 注意: 旧密钥曾硬编码入库(git历史可见), 请在API平台轮换后使用新值

# wanqing内部网关(GLM/kimi/claude端点 + embedding)
WQ_API_KEY=<your-wanqing-key>
WQ_BASE_URL=https://wanqing-api.corp.kuaishou.com/api/gateway/v1/endpoints

# moonshot kimi(外网)
KIMI_KEY=<your-moonshot-key>

# 智谱GLM(外网)
GLM_KEY=<your-zhipu-key>
