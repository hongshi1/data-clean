  "bottleneck_analysis": [
    {
      "rank": 1,
      "bottleneck": "BGE dense encoding (GPU)",
      "evidence": [
        "feature_snapshot: 27473 texts in 119s embed-only (230.5/s); whole pipeline corpus build is 129s of which >92% is embedding",
        "O1-unit index build: 76.18s for 11539 units (151.5/u) vs BM25-unit index 0.13s (585x faster to build)",
        "CPU fallback collapses throughput 8.4x (24.7 texts/s) - GPU is a hard requirement for offline corpus building"
      ],
      "mitigation": "batch texts (512-batch gives 393/s vs 208/s at 100-batch with longer texts); keep disk cache warm; vector reuse across features (single encode pass, many consumers)"
    },
    {
      "rank": 2,
      "bottleneck": "L2 NLI residual inference (per-instance, standard preset)",
      "evidence": [
        "verifier standard 117.75ms/instance mean vs fast 8.37ms -> NLI adds ~110ms/instance (93% of standard latency)",
        "NLI pair scorer 32.4ms/pair (2 directional inferences); batch amortization 3.4ms/pair (GPU batch32=109.3ms)",
        "first verify pays lazy model load: 2383ms in-process / 6820ms via HTTP service"
      ],
      "mitigation": "fast preset for interactive use (8ms); NLI batch the residual claims (already batched internally); warm the engine at service startup (currently lazy)"
    },
    {
      "rank": 3,
      "bottleneck": "per-query BGE encode inside recall search",
      "evidence": [
        "O1-unit search 13.86ms/query of which ~9ms is query encode (single BGE forward, batch=1) - the matrix scoring itself is ~2-5ms",
        "recall dominates the fast-preset end-to-end chain (60.6% of 28.3ms total)"
      ],
      "mitigation": "query micro-batching, or cache frequent queries; BM25 search latency is comparable (13.1ms) because its pure-Python unit loop is the same order"
    },
    {
      "rank": 4,
      "non_bottleneck": "deterministic components (atomizer, purifier, coverage, expert channels)",
      "evidence": [
        "atomizer 217055.4/s (all 11869 claims in 0.055s)",
        "purifier statement-mode 0.85ms/instance",
        "coverage detector 133.0ms for 1207 tables",
        "fast verifier (L0/L1 experts) 8.37ms/instance"
      ]
    }
