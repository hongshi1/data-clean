  "uml_type": "ASSOCIATION",
  "label": "inconsistent",
  "inject_type": "direction_fabrication",
  "question": "图中「数据转换」和「数据结构转换」之间的关系方向是什么？",
  "answer": "图中显示「数据结构转换」指向「数据转换」，即数据结构转换依赖数据转换。（实际是关联关系无方向，不存在指向）",
  "difficulty": "medium",
  "evidence": {
   "embed": "oleObject4.bin:page1.xml",
   "uml_type": "ASSOCIATION",
   "src": "数据转换",
   "dst": "数据结构转换",
   "line_pattern": "solid",
   "end_arrow": "none"
  },
  "source": "uml_negative"
 },
 {
