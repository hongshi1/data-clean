 },
 {
  "id": "uml_02界面集成框架_35_7867_3175_pos",
  "pair_id": "02界面集成框架_35",
  "doc": "02界面集成框架软件需求规格说明-终稿",
  "uml_type": "ASSOCIATION",
  "label": "consistent",
  "question": "请描述「应用软件」和「主界面组件展现」在图中的连接方式及其含义。",
  "answer": "应用软件和主界面组件展现通过无箭头的实线连接，这是UML中的关联关系(ASSOCIATION)。关联表示两个元素之间的结构关系，两端都没有导航箭头意味着关系是双向的。",
  "difficulty": "medium",
  "evidence": {
   "embed": "oleObject36.bin:page1.xml",
   "uml_type": "ASSOCIATION",
   "src": "应用软件",
   "dst": "主界面组件展现",
   "line_pattern": "solid",
   "end_arrow": "none"
  },
  "source": "uml_positive"
 },
 {
