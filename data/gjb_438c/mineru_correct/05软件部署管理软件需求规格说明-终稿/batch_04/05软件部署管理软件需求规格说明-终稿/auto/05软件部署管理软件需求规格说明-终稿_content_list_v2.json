                    }
                ],
                "html": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">Usecase名称</td><td colspan=\"1\" rowspan=\"1\">项目唯一标识符</td><td colspan=\"1\" rowspan=\"1\">需求描述</td><td colspan=\"1\" rowspan=\"1\">需求重用</td><td colspan=\"1\" rowspan=\"1\">方式名称</td><td colspan=\"1\" rowspan=\"1\">运行状态</td><td colspan=\"1\" rowspan=\"1\">对应的任务书功能/性能</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">用户基本信息维护</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-YHJBXXWH</td><td colspan=\"1\" rowspan=\"1\">提供用户基本信息（用户ID、用户密码）编辑、导入、导出的维护功能；</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">坐位信</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-</td><td colspan=\"1\" rowspan=\"1\">提供坐位信息（坐位名称、坐</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平</td><td colspan=\"1\" rowspan=\"1\">集成阶</td><td colspan=\"1\" rowspan=\"1\">4.1.4 b)</td></tr><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">息维护</td><td colspan=\"1\" rowspan=\"1\">RJBSGL-YHGL-XWXXWH</td><td colspan=\"1\" rowspan=\"1\">位描述、坐位功能菜单）编辑、导入、导出的维护功能，支持坐位模板制作和依据坐位模板的坐位制作功能；</td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">板</td><td colspan=\"1\" rowspan=\"1\">段、运行阶段</td><td colspan=\"1\" rowspan=\"1\"></td></tr><tr><td colspan=\"1\" rowspan=\"1\">3</td><td colspan=\"1\" rowspan=\"1\">坐位分配</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-XWFP</td><td colspan=\"1\" rowspan=\"1\">提供坐位分配的功能，能够为用户分配坐位，完成坐位信息和用户信息的关联匹配；</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 c)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">4</td><td colspan=\"1\" rowspan=\"1\">功能组件维护</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-GNZJWH</td><td colspan=\"1\" rowspan=\"1\">提供功能组件的编辑功能，支持组件的导入、导出；</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 d)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">5</td><td colspan=\"1\" rowspan=\"1\">用户功能菜单维护</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-YHGNCDWH</td><td colspan=\"1\" rowspan=\"1\">提供用户功能菜单的编辑、导入、导出维护功能；</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 e)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">6</td><td colspan=\"1\" rowspan=\"1\">编组信息查看</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-BZXXCK</td><td colspan=\"1\" rowspan=\"1\">提供编组文件的导入、查看功能，能够查看编组内用户信息；</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 f)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">7</td><td colspan=\"1\" rowspan=\"1\">编组用户信息维护</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-BZYHXXWH</td><td colspan=\"1\" rowspan=\"1\">提供对编组内的用户进行坐位分配功能，能够将编组内的用户信息数据导出为 sqI 文件;</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 g)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">8</td><td colspan=\"1\" rowspan=\"1\">用户信息制作</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-YHXXZZ</td><td colspan=\"1\" rowspan=\"1\">提供用户信息数据（用户基本信息、角色信息、权限信息、功能菜单信息）制作功能，支持将用户信息数据导出为 sqI 文件；</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 h)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">9</td><td colspan=\"1\" rowspan=\"1\">用户数据备份还原</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-RJBSGL-YHGL-YHSJBFHY</td><td colspan=\"1\" rowspan=\"1\">提供用户数据备份还原功能，能够在用户登录时加载用户使用数据（界面菜单信息、界面布局信息、态势图层信息以及和用户相关的应用配置信息），能够在用户退出登录时保存用户使用数据。</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.4 i)</td></tr></table>",
                "table_type": "complex_table",
