        ],
        "table_footnote": [],
        "table_body": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">Use case 名称</td><td colspan=\"1\" rowspan=\"1\">项目唯一标识符</td><td colspan=\"1\" rowspan=\"1\">需求描述</td><td colspan=\"1\" rowspan=\"1\">需求重用</td><td colspan=\"1\" rowspan=\"1\">方式名称</td><td colspan=\"1\" rowspan=\"1\">运行状态</td><td colspan=\"1\" rowspan=\"1\">对应的任务书功能/性能</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">网络设备接入</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-SBJR-WLSBJR</td><td colspan=\"1\" rowspan=\"1\">提供网络设备物理接入的功能，支持以UDP、TCP的方式接入网络通信设备；</td><td colspan=\"1\" rowspan=\"1\">沿用</td><td colspan=\"1\" rowspan=\"1\">桌面版、平板版、手持版</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.6 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">专用设备接入</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-SBJR-ZYSBJR</td><td colspan=\"1\" rowspan=\"1\">提供专用设备驱动软件接入的功能，支持专用设备驱动软件通过专用接口接入的方式接入；</td><td colspan=\"1\" rowspan=\"1\">沿用</td><td colspan=\"1\" rowspan=\"1\">桌面版、平板版、手持版</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.6 b)/4.2 c)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">3</td><td colspan=\"1\" rowspan=\"1\">北斗设备接入</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-SBJR-BDSBJR</td><td colspan=\"1\" rowspan=\"1\">提供北斗设备接入服务软件接入的功能；</td><td colspan=\"1\" rowspan=\"1\">沿用</td><td colspan=\"1\" rowspan=\"1\">桌面版、平板版、手持版</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.6 c)/4.2 c)</td></tr></table>",
