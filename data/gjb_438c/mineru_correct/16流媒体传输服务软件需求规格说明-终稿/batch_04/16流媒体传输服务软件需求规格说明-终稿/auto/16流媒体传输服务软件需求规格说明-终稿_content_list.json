        "page_idx": 1
    },
    {
        "type": "text",
        "text": "流媒体传输服务软件质量要求与措施见表42所示。",
        "bbox": [
            152,
            512,
            596,
            530
        ],
        "page_idx": 1
    },
    {
        "type": "table",
        "img_path": "images/a6986ab735c1b5b00ceda4e1280fcfefa6bd5a657315833fadb983ec504ddb55.jpg",
        "table_caption": [
            "表42 流媒体传输服务软件质量要求与措施表"
        ],
        "table_footnote": [],
        "table_body": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">软件质量因素</td><td colspan=\"1\" rowspan=\"1\">软件质量因素描述</td><td colspan=\"1\" rowspan=\"1\">要求程度</td><td colspan=\"1\" rowspan=\"1\">采取的措施</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">功能性</td><td colspan=\"1\" rowspan=\"1\">实现全部所需功能的能力</td><td colspan=\"1\" rowspan=\"1\">符合3.2节系统能力需求</td><td colspan=\"1\" rowspan=\"1\">通过系统需求分析和软件设计满足功能指标</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">可靠性</td><td colspan=\"1\" rowspan=\"1\">产生正确、一致结果的能力</td><td colspan=\"1\" rowspan=\"1\">能够过滤用户非法输入，将异常信息提示给用户</td><td colspan=\"1\" rowspan=\"1\">通过异常处理模块</td></tr><tr><td colspan=\"1\" rowspan=\"1\">3</td><td colspan=\"1\" rowspan=\"1\">可维护性</td><td colspan=\"1\" rowspan=\"1\">易于更正的能力</td><td colspan=\"1\" rowspan=\"1\">维护人员可快速定位故障</td><td colspan=\"1\" rowspan=\"1\">运行日志记录文件</td></tr><tr><td colspan=\"1\" rowspan=\"1\">4</td><td colspan=\"1\" rowspan=\"1\">可用性</td><td colspan=\"1\" rowspan=\"1\">需要时进行访问和操作的能力</td><td colspan=\"1\" rowspan=\"1\">无</td><td colspan=\"1\" rowspan=\"1\">无</td></tr><tr><td colspan=\"1\" rowspan=\"1\">5</td><td colspan=\"1\" rowspan=\"1\">灵活性</td><td colspan=\"1\" rowspan=\"1\">易于适应需求变化的能力</td><td colspan=\"1\" rowspan=\"1\">无</td><td colspan=\"1\" rowspan=\"1\">无</td></tr><tr><td colspan=\"1\" rowspan=\"1\">6</td><td colspan=\"1\" rowspan=\"1\">可移植性</td><td colspan=\"1\" rowspan=\"1\">易于修改以适应新环境的能力</td><td colspan=\"1\" rowspan=\"1\">无</td><td colspan=\"1\" rowspan=\"1\">无</td></tr><tr><td colspan=\"1\" rowspan=\"1\">7</td><td colspan=\"1\" rowspan=\"1\">可重用性</td><td colspan=\"1\" rowspan=\"1\">可被多个应用使用的能力</td><td colspan=\"1\" rowspan=\"1\">无</td><td colspan=\"1\" rowspan=\"1\">无</td></tr><tr><td colspan=\"1\" rowspan=\"1\">8</td><td colspan=\"1\" rowspan=\"1\">可测试性</td><td colspan=\"1\" rowspan=\"1\">易于充分测试的能力</td><td colspan=\"1\" rowspan=\"1\">可仿真环境下完成主要功能验证</td><td colspan=\"1\" rowspan=\"1\">依靠操作系统和仿真网络</td></tr><tr><td colspan=\"1\" rowspan=\"1\">9</td><td colspan=\"1\" rowspan=\"1\">易用性</td><td colspan=\"1\" rowspan=\"1\">易于学习和使用的能力</td><td colspan=\"1\" rowspan=\"1\">人机接口友好，简洁、</td><td colspan=\"1\" rowspan=\"1\">采用统一人机交</td></tr><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">一致，并形成闭环反馈</td><td colspan=\"1\" rowspan=\"1\">互规范对人机接口进行一体设计，按业务流程和实装操作进行界面设计和交互设计</td></tr><tr><td colspan=\"1\" rowspan=\"1\">10</td><td colspan=\"1\" rowspan=\"1\">易分析性</td><td colspan=\"1\" rowspan=\"1\">提供日志功能，用于记录软件运行过程中关键处理和运行情况；软件异常时，可根据日志记录定位软件异常位置和原因；</td><td colspan=\"1\" rowspan=\"1\">软件程序代码注释率：不小于20%</td><td colspan=\"1\" rowspan=\"1\">采用统一代码规范，对代码进行静态检查；分析代码中关键处理逻辑、异常控制逻辑，打印日志</td></tr><tr><td colspan=\"1\" rowspan=\"1\">11</td><td colspan=\"1\" rowspan=\"1\">稳定性</td><td colspan=\"1\" rowspan=\"1\">软件稳定运行，资源占用率保持平稳</td><td colspan=\"1\" rowspan=\"1\">无</td><td colspan=\"1\" rowspan=\"1\">软件实现中，对内存、cpu等资源精准控制；通过压力测试和重复测试保证软件稳定运行</td></tr><tr><td colspan=\"1\" rowspan=\"1\">12</td><td colspan=\"1\" rowspan=\"1\">易恢复性</td><td colspan=\"1\" rowspan=\"1\">当软件模块运行发生错误时，可查看错误提示，软件运行异常中止情况下，软件应能重新启动运行</td><td colspan=\"1\" rowspan=\"1\">平均失效恢复时间(MTTR):不大于0.5小时</td><td colspan=\"1\" rowspan=\"1\">组件化设计，降低软件之间耦合度；软件服务化、对象化，实现软件负载均衡、可恢复</td></tr><tr><td colspan=\"1\" rowspan=\"1\">13</td><td colspan=\"1\" rowspan=\"1\">容错性</td><td colspan=\"1\" rowspan=\"1\">对软件输入输出信息进行数据处理范围和规则检验软件能识别异常值，提示用户</td><td colspan=\"1\" rowspan=\"1\">软件缺陷密度（FD)低于3.6(缺陷数/千行)</td><td colspan=\"1\" rowspan=\"1\">通过软件设计、单元测试、集成测试控制缺陷密度</td></tr></table>",
        "bbox": [
