                "html": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">Usecase 名称</td><td colspan=\"1\" rowspan=\"1\">项目唯一标识符</td><td colspan=\"1\" rowspan=\"1\">需求描述</td><td colspan=\"1\" rowspan=\"1\">需求重用</td><td colspan=\"1\" rowspan=\"1\">方式名称</td><td colspan=\"1\" rowspan=\"1\">运行状态</td><td colspan=\"1\" rowspan=\"1\">对应的任务书功能/性能</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">服务启停控制</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-FWQTKZ</td><td colspan=\"1\" rowspan=\"1\">控制服务进程的启动与停止。</td><td colspan=\"1\" rowspan=\"1\">沿用</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">服务启动控制方式控制</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-FWQTKZ</td><td colspan=\"1\" rowspan=\"1\">根据启动方式对服务控制</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3</td></tr><tr><td colspan=\"1\" rowspan=\"1\">3</td><td colspan=\"1\" rowspan=\"1\">服务启动优先级控制</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-FWQDYXJKZ</td><td colspan=\"1\" rowspan=\"1\">根据启动优先级对服务控制</td><td colspan=\"1\" rowspan=\"1\">沿用</td><td colspan=\"1\" rowspan=\"1\">桌面、平</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3</td></tr><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">板、手持</td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td></tr><tr><td colspan=\"1\" rowspan=\"1\">4</td><td colspan=\"1\" rowspan=\"1\">服务启动依赖控制</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-FWQDYLKZ</td><td colspan=\"1\" rowspan=\"1\">启动依赖对服务控制</td><td colspan=\"1\" rowspan=\"1\">沿用</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3</td></tr><tr><td colspan=\"1\" rowspan=\"1\">5</td><td colspan=\"1\" rowspan=\"1\">服务异常重启</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-FWYCCQ</td><td colspan=\"1\" rowspan=\"1\">服务异常，服务管控重启</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3</td></tr><tr><td colspan=\"1\" rowspan=\"1\">6</td><td colspan=\"1\" rowspan=\"1\">服务状态采集</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-FWZTCJ</td><td colspan=\"1\" rowspan=\"1\">采集服务的运行状态信息</td><td colspan=\"1\" rowspan=\"1\">沿用</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3/4.2 b)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">7</td><td colspan=\"1\" rowspan=\"1\">服务占用资源采集</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-FWZYZYCJ</td><td colspan=\"1\" rowspan=\"1\">采集服务占用资源的相关信息，包括CPU占用率、内存占用率和磁盘使用率等信息；</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3</td></tr><tr><td colspan=\"1\" rowspan=\"1\">8</td><td colspan=\"1\" rowspan=\"1\">节点信息采集</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWYXKZ-JDXXCJ</td><td colspan=\"1\" rowspan=\"1\">采集节点的 CPU 使用率、内存使用率、磁盘使用率和某时段的平均网速信息</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.3</td></tr></table>",
