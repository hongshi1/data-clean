        "table_footnote": [],
        "table_body": "<table><tr><td rowspan=1 colspan=1>序号</td><td rowspan=1 colspan=1>Use case名称</td><td rowspan=1 colspan=1>项目唯一标识符</td><td rowspan=1 colspan=1>需求描述</td><td rowspan=1 colspan=1>需求重用</td><td rowspan=1 colspan=1>方式名称</td><td rowspan=1 colspan=1>运行状态</td><td rowspan=1 colspan=1>对应的任务书功能/性能</td></tr><tr><td rowspan=1 colspan=1>1</td><td rowspan=1 colspan=1>服务访问路由</td><td rowspan=1 colspan=1>PZXQ-FWJCKJ-GN-FWFWLY</td><td rowspan=1 colspan=1>支持将服务请求发送到具体的服务实例</td><td rowspan=1 colspan=1>新增</td><td rowspan=1 colspan=1>桌面、平板、手持</td><td rowspan=1 colspan=1>运行阶段</td><td rowspan=1 colspan=1>4.1.5</td></tr><tr><td rowspan=1 colspan=1>2</td><td rowspan=1 colspan=1>服务响应转发</td><td rowspan=1 colspan=1>PZXQ-FWJCKJ-GN-FWXYZF</td><td rowspan=1 colspan=1>支持将服务响应发给服务访问发起者</td><td rowspan=1 colspan=1>新增</td><td rowspan=1 colspan=1>桌面、平板、手持</td><td rowspan=1 colspan=1>运行阶段</td><td rowspan=1 colspan=1>4.1.5</td></tr><tr><td rowspan=1 colspan=1>3</td><td rowspan=1 colspan=1>服务访问信息记录</td><td rowspan=1 colspan=1>PZXQ-FWJCKJ-GN-FWFWJL</td><td rowspan=1 colspan=1>服务调用发起的时间、调用方法、响应状态码进行记录</td><td rowspan=1 colspan=1>新增</td><td rowspan=1 colspan=1>桌面、平板、手持</td><td rowspan=1 colspan=1>运行阶段</td><td rowspan=1 colspan=1>4.1.5</td></tr><tr><td rowspan=1 colspan=1>4</td><td rowspan=1 colspan=1>服务访问信息维护</td><td rowspan=1 colspan=1>PZXQ-FWJCKJ-GN-FWFWWH</td><td rowspan=1 colspan=1>服务请求数据中提取会话信息进行维护</td><td rowspan=1 colspan=1>新增</td><td rowspan=1 colspan=1>桌面、平板、手持</td><td rowspan=1 colspan=1>运行阶段</td><td rowspan=1 colspan=1>4.1.5</td></tr><tr><td rowspan=1 colspan=1>5</td><td rowspan=1 colspan=1>向前端推送消息</td><td rowspan=1 colspan=1>PZXQ-FWJCKJ-GN-QDTSXX</td><td rowspan=1 colspan=1>支持后台程序主动向前端界面推送数据</td><td rowspan=1 colspan=1>新增</td><td rowspan=1 colspan=1>桌面、平板、手持</td><td rowspan=1 colspan=1>运行阶段</td><td rowspan=1 colspan=1>4.1.5</td></tr></table>",
