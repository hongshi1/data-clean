        "table_body": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">Usecase 名称</td><td colspan=\"1\" rowspan=\"1\">项目唯一标识符</td><td colspan=\"1\" rowspan=\"1\">需求描述</td><td colspan=\"1\" rowspan=\"1\">需求重用</td><td colspan=\"1\" rowspan=\"1\">方式名称</td><td colspan=\"1\" rowspan=\"1\">运行状态</td><td colspan=\"1\" rowspan=\"1\">对应的任务书功能/性能</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">服务注册</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWBSGL-FWZC</td><td colspan=\"1\" rowspan=\"1\">需要通过服务描述信息完成服务注册，使得服务全局可知</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.2/4.2 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">服务更新</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWBSGL-FWGX</td><td colspan=\"1\" rowspan=\"1\">对服务的信息更新</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.2</td></tr><tr><td colspan=\"1\" rowspan=\"1\">3</td><td colspan=\"1\" rowspan=\"1\">服务监控注册</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWBSGL-FWJKZC</td><td colspan=\"1\" rowspan=\"1\">调用接口注册对某个服务进行资源占用和状态监控</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.2</td></tr><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">手持</td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td></tr><tr><td colspan=\"1\" rowspan=\"1\">4</td><td colspan=\"1\" rowspan=\"1\">服务注销</td><td colspan=\"1\" rowspan=\"1\">PZXQ-GN-FWBSGL-FWZX</td><td colspan=\"1\" rowspan=\"1\">通过服务描述信息完成服务注册信息的删除</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.2</td></tr></table>",
