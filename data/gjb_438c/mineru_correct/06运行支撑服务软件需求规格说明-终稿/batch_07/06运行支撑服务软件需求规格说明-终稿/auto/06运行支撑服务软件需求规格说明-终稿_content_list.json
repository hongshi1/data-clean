        "table_body": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">Usecase名称</td><td colspan=\"1\" rowspan=\"1\">项目唯一标识符</td><td colspan=\"1\" rowspan=\"1\">需求描述</td><td colspan=\"1\" rowspan=\"1\">需求重用</td><td colspan=\"1\" rowspan=\"1\">方式名称</td><td colspan=\"1\" rowspan=\"1\">运行状态</td><td colspan=\"1\" rowspan=\"1\">对应的任务书功能/性能</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">消息提示</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-RZCJYGL-XXTS</td><td colspan=\"1\" rowspan=\"1\">提供消息提示功能，支持以弹框的形式对消息进行提示</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.8 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">消息管理</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-RZCJYGL-XXGL</td><td colspan=\"1\" rowspan=\"1\">提供消息的管理能力，支持将消息通过数据统一访问服务存储至数据库中，提供消息查询接口</td><td colspan=\"1\" rowspan=\"1\">改进</td><td colspan=\"1\" rowspan=\"1\">桌面</td><td colspan=\"1\" rowspan=\"1\">运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.8 b)</td></tr></table>",
