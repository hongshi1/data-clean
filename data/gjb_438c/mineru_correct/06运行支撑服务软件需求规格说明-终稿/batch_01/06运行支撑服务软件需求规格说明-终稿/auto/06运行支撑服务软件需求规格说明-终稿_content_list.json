        "table_footnote": [],
        "table_body": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">Usecase名称</td><td colspan=\"1\" rowspan=\"1\">项目唯一标识符</td><td colspan=\"1\" rowspan=\"1\">需求描述</td><td colspan=\"1\" rowspan=\"1\">需求重用</td><td colspan=\"1\" rowspan=\"1\">方式名称</td><td colspan=\"1\" rowspan=\"1\">运行状态</td><td colspan=\"1\" rowspan=\"1\">对应的任务书功能/性能</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">计算机CPU状态详细信息</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-JSJZTJK-JSJCPUZTXXXX</td><td colspan=\"1\" rowspan=\"1\">能够读取计算机中正在运行软件的 CPU状态详细信息，对以上数据进行汇总并进行显示</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1 b)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">计算机内存状态详细信息</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-JSJZTJK-JSJNCZTXXXX</td><td colspan=\"1\" rowspan=\"1\">能够读取计算机中正在运行软件的内存占用详细信息，对以上数据进行汇总并进行显示</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1b)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">3</td><td colspan=\"1\" rowspan=\"1\">计算机硬盘状态详细信息</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-JSJZTJK-JSJYPZTXXXX</td><td colspan=\"1\" rowspan=\"1\">能够读取计算机中正在运行软件的磁盘占用详细信息，对以上数据进行汇总并进行显示</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1b)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">4</td><td colspan=\"1\" rowspan=\"1\">与服务器网络连接状态详细</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-JSJZTJK-JSJYFWQWLLJZTXXXX</td><td colspan=\"1\" rowspan=\"1\">能够读取本机与服务器网络连通信息包括上行速度和下行速度，对以上数据进行汇总并进行显示</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1b)</td></tr><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">信息</td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"></td></tr></table>",
