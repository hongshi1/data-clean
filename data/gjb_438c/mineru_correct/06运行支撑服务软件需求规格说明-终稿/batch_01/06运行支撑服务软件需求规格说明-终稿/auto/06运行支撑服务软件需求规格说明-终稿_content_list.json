        "table_footnote": [],
        "table_body": "<table><tr><td colspan=\"1\" rowspan=\"1\">序号</td><td colspan=\"1\" rowspan=\"1\">Use case名称</td><td colspan=\"1\" rowspan=\"1\">项目唯一标识符</td><td colspan=\"1\" rowspan=\"1\">需求描述</td><td colspan=\"1\" rowspan=\"1\">需求重用</td><td colspan=\"1\" rowspan=\"1\">方式名称</td><td colspan=\"1\" rowspan=\"1\">运行状态</td><td colspan=\"1\" rowspan=\"1\">对应的任务书功能/性能</td></tr><tr><td colspan=\"1\" rowspan=\"1\">1</td><td colspan=\"1\" rowspan=\"1\">CPU 占用信息提示</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-ZYXXTS-CPUZYXXTS</td><td colspan=\"1\" rowspan=\"1\">能够显示计算机 CPU 占用状态信息</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">2</td><td colspan=\"1\" rowspan=\"1\">内存占用信息提示</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-ZYXXTS-NCZYXXTS</td><td colspan=\"1\" rowspan=\"1\">能够显示计算机内存占用状态信息</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">3</td><td colspan=\"1\" rowspan=\"1\">磁盘占用</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-</td><td colspan=\"1\" rowspan=\"1\">能够显示计算</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、</td><td colspan=\"1\" rowspan=\"1\">开发阶段、</td><td colspan=\"1\" rowspan=\"1\">4.1.1 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">信息提示</td><td colspan=\"1\" rowspan=\"1\">ZYXXTS-CPZYXXTS</td><td colspan=\"1\" rowspan=\"1\">机磁盘占用状态信息</td><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\">平板、手持</td><td colspan=\"1\" rowspan=\"1\">集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\"></td></tr><tr><td colspan=\"1\" rowspan=\"1\">4</td><td colspan=\"1\" rowspan=\"1\">服务启动数量提示</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-ZYXXTS-FWQDSLTS</td><td colspan=\"1\" rowspan=\"1\">能够显示计算机服务启动数量</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">5</td><td colspan=\"1\" rowspan=\"1\">数据库连接状态提示</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-ZYXXTS-SJKLJZTTS</td><td colspan=\"1\" rowspan=\"1\">能够显示计算机数据库连接状态</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1 a)</td></tr><tr><td colspan=\"1\" rowspan=\"1\">6</td><td colspan=\"1\" rowspan=\"1\">服务器网络连接状态提示</td><td colspan=\"1\" rowspan=\"1\">PZXQ-YXZCFW-GN-XTYXZTJK-ZYXXTS-FWQWLLJZTTS</td><td colspan=\"1\" rowspan=\"1\">能够显示计算机与服务器网络连接状态</td><td colspan=\"1\" rowspan=\"1\">新增</td><td colspan=\"1\" rowspan=\"1\">桌面、平板、手持</td><td colspan=\"1\" rowspan=\"1\">开发阶段、集成阶段、运行阶段</td><td colspan=\"1\" rowspan=\"1\">4.1.1 a)</td></tr></table>",
