 "extraction_templates": {
  "e1_entry_head": {
   "pattern": "(?:异常流)?E\\d?\\s*[：:]",
   "flags": 32
  },
  "e1_entry_parse": {
   "pattern": "(?:异常流)?(?P<id>E\\d?)\\s*[：:]\\s*(?:系统提示)?(?P<prompt>[^，,。；;\\n]*)(?:[，,]\\s*(?P<ending>.*))?",
   "flags": 32
  },
  "e1_exception_claim": {
   "pattern": "异常|E\\d|触发|提示|失败|错误|终止|结束|恢复|故障",
   "flags": 32
  },
  "e1_claimed_e_id": {
   "pattern": "(?<![A-Za-z0-9])(E\\d)(?![A-Za-z0-9])",
   "flags": 32
  },
  "e1_answer_prompt_quoted": {
   "pattern": "(?:提示|显示|给出|返回|弹出)(?:信息|内容)?\\s*[：:]?\\s*[“\\\"](?P<quoted>[^”\\\"]{1,60})(?:[”\\\"]|$)",
   "flags": 32
  },
  "e1_answer_prompt_plain": {
   "pattern": "(?:提示|显示|给出|弹出|返回)(?P<plain>[^，,。；;”\\\"「」“]{1,30})",
   "flags": 32
  },
  "e1_prompt_connective": {
   "pattern": "(?:并且|并|且|同时|然后|随后|之后)(?=继续|终止|结束|返回|恢复|提示|显示|退出|执行).*$",
   "flags": 32
  },
  "e1_generic_prompt_text": {
   "pattern": "^(?:相应|相关|对应|适当|合适|具体|详细)?的?(?:错误|警告|失败|成功|提示|异常)*(?:信息|内容|消息|文本)?$",
   "flags": 32
  },
  "e1_prompt_q": {
   "pattern": "提示信息|什么提示|哪些提示|返回什么|显示什么|提示什么|提示内容",
   "flags": 32
  },
  "e1_evidence_prompt_verb": {
   "pattern": "(?:提示|显示|给出)(?:信息|内容)?[：:]?(?P<span>[^，,。；;”\\\"「」“\\n]{1,40})",
   "flags": 32
  },
  "e1_evidence_trigger": {
   "pattern": "(?:如果|若|当|在)(?P<span>[^，,。；;\\n]{2,40}?)(?:时|情况下|条件下)?[，,]",
   "flags": 32
  },
  "e1_continue_claim": {
   "pattern": "(?:继续|恢复|重试|重新(?:执行|开始|处理|输入|配置|尝试))(?=[^，,。；;]{0,8}(?:用例|流程|事件流|过程|步骤))|(?:用例|流程|事件流|过程|步骤)(?:继续|恢复)",
   "flags": 32
  },
  "e1_end_claim": {
   "pattern": "(?:结束|终止|中止)(?=[^，,。；;]{0,8}(?:用例|流程|事件流|过程|步骤))|(?:用例|流程|事件流|过程|步骤)(?:结束|终止|中止)",
   "flags": 32
  },
  "e1_ending_only": {
   "pattern": "^\\s*(?:用例|流程|步骤)?\\s*(?:结束|终止|中止|继续|恢复)\\s*[。.；;]?\\s*$",
   "flags": 32
  },
  "e1_continue_words": {
   "pattern": "继续|恢复|重试|重新(?:执行|开始|处理)",
   "flags": 32
  },
  "e1_e1_assertion": {
   "pattern": "异常流\\s*E\\d?\\s*[：:]",
   "flags": 32
  },
  "e1_exception_q": {
   "pattern": "异常处理|异常流|异常情况|触发.{0,6}异常|发生错误|出现异常",
   "flags": 32
  },
  "e1_punct": {
   "pattern": "[\\s，,。；;、：:！？“”\\\"'（）()\\[\\]【】·-]",
   "flags": 32
  },
  "id_pattern": {
   "pattern": "PZXQ-[A-Z0-9-]+",
   "flags": 32
  },
  "id_binding": {
   "pattern": "(?P<name>[A-Za-z0-9\\u4e00-\\u9fff][A-Za-z0-9\\u4e00-\\u9fff-]{0,40}?)的(?:项目唯一标识符|唯一标识符|接口需求标识|接口标识|功能标识|标识符|标识|编号|代号)(?:(?:分别|均|都|也|是|为)[：:]?)*[：:]?(?P<id>PZXQ-[A-Z0-9-]+)",
   "flags": 32
  },
  "id_section_title": {
   "pattern": "(?P<sec>\\d+(?:\\.\\d+)+)(?P<name>[\\u4e00-\\u9fffA-Za-z][\\u4e00-\\u9fffA-Za-z0-9-]{0,40}?)[（(](?P<id>PZXQ-[A-Z0-9-]+)[）)]",
   "flags": 32
  },
  "id_role_tail": {
   "pattern": "的?(?:项目唯一标识符|唯一标识符|接口需求标识|接口标识|功能标识|标识符|标识|编号|代号|名称|序号)(?:(?:分别|均|都|也|是|为)[：:]?)*[：:]?$",
   "flags": 32
  },
  "id_bracket_subject": {
   "pattern": "(?P<subj>[A-Za-z0-9\\u4e00-\\u9fff]{2,24})[（(]\\s*[「\\\"]?\\s*$",
   "flags": 32
  },
  "id_segment_split": {
   "pattern": "[：:\\n|，,。；;]",
   "flags": 32
  },
  "id_noun_run": {
   "pattern": "[A-Za-z0-9\\u4e00-\\u9fff]{2,24}",
   "flags": 32
  },
  "id_window_tail_strip": {
   "pattern": "[\\s*_`#>|·]+$",
   "flags": 32
  },
  "id_leading_table_ref": {
   "pattern": "^表\\d+中",
   "flags": 32
  },
  "id_subject_role_trim": {
   "pattern": "(?:用例|能力|功能)$",
   "flags": 32
  },
  "enum_field_value": {
   "pattern": "(?P<subj>[\\u4e00-\\u9fffA-Za-z0-9]{2,20})的(?P<field>需求重用|方式名称|运行状态|对应的任务书功能性能)[：:](?P<value>.+)",
   "flags": 32
  },
  "enum_sentence": {
   "pattern": "(?P<subj>[\\u4e00-\\u9fffA-Za-z0-9]{2,20}?)(?:功能|操作|服务|内容)?(?:包括|包含|分为|划分为)[：:]?(?P<items>[^，,。；;\\n]{4,120})",
   "flags": 32
  },
  "enum_id_binding": {
   "pattern": "(?P<subj>[\\u4e00-\\u9fffA-Za-z0-9]{2,20}?)的(?:项目唯一标识符|唯一标识符|接口需求标识|接口标识|功能标识)[：:](?P<id>PZXQ-[A-Z0-9-]+)",
   "flags": 32
  },
  "enum_section_title": {
   "pattern": "\\d+(?:\\.\\d+)+(?P<name>[\\u4e00-\\u9fffA-Za-z0-9-]{2,40}?)[（(](?P<id>PZXQ-[A-Z0-9-]+)[）)]",
   "flags": 32
  },
  "enum_device": {
   "pattern": "在(?P<items>[\\u4e00-\\u9fffA-Za-z0-9、和]{6,60}?)(?:等)?(?:种版本|版本|设备|终端|平台)?上(?:运行|使用|提供|均可|实施)",
   "flags": 32
  },
  "enum_question_subject": {
   "pattern": "(?P<subj>[\\u4e00-\\u9fffA-Za-z0-9]{2,24}?)(?:包括|包含|涉及|以哪些|有哪些|哪些)",
   "flags": 32
  },
  "enum_member_valid": {
   "pattern": "[\\u4e00-\\u9fffA-Za-z0-9]{2,16}",
   "flags": 32
  },
  "enum_member_split": {
   "pattern": "[、，,]|以及|和",
   "flags": 32
  },
  "enum_count_function_suffix": {
   "pattern": "(?:[一二三四五六七八九十两\\d]+)?项功能$",
   "flags": 32
  },
  "enum_subject_role_suffix": {
   "pattern": "(?:的支持方式|的方式名称|的运行状态|的功能标识表|的具体操作|的主要功能|的核心操作|的子功能)$",
   "flags": 32
  },
  "enum_leading_table": {
   "pattern": "^表\\d+",
   "flags": 32
  },
  "enum_generic_subject": {
   "pattern": "^(?:所有|这些|上述|全部|该|其|每|各)?(?:操作|功能|用例|设备|版本|步骤|内容|方面|模块|场景|参数)$",
   "flags": 32
  },
  "enum_phase_words": {
   "pattern": "开发阶段|运行阶段",
   "flags": 32
  },
  "enum_member_split_device": {
   "pattern": "[、和]",
   "flags": 32
  },
  "enum_device_subject_run": {
   "pattern": "[\\u4e00-\\u9fffA-Za-z0-9]{2,16}$",
   "flags": 32
  },
  "seq_step": {
   "pattern": "(\\d+)[.．、]\\s*([^；;\\n]+)",
   "flags": 32
  },
  "seq_exception_field": {
   "pattern": "^异常流E?\\d*$",
   "flags": 32
  },
  "seq_question_scope": {
   "pattern": "(?P<name>[\\u4e00-\\u9fffA-Za-z0-9-]{2,24}?)(?:的)?(?:主事件流|事件流|用例描述)",
   "flags": 32
  },
  "seq_preamble": {
   "pattern": "包括以下|如下|这些操作|确保",
   "flags": 32
  },
  "seq_punct": {
   "pattern": "[\\s：:，,。；;、（）()「」\\[\\]【】*·]",
   "flags": 32
  },
  "seq_flow_question": {
   "pattern": "主事件流|事件流|步骤|流程|时序|顺序|依次|先后",
   "flags": 32
  },
  "seq_substantive_step": {
   "pattern": "[\\u4e00-\\u9fff]{2,}",
   "flags": 32
  },
  "trace_section_split": {
   "pattern": "[、，,]",
   "flags": 32
  },
  "trace_segment_split": {
   "pattern": "[。；;\\n]",
   "flags": 32
  },
  "trace_relation_words": {
   "pattern": "对应|追溯|映射|追踪|关联|引用|来自|源于|依据",
   "flags": 32
  },
  "trace_trace_relation_words": {
   "pattern": "追溯|追踪|映射",
   "flags": 32
  },
  "trace_section_token": {
   "pattern": "\\d+(?:\\.\\d+)+\\s*[a-hA-H]?[)）]?",
   "flags": 32
  },
  "trace_taskbook_section": {
   "pattern": "^4(?:\\.\\d+)+",
   "flags": 32
  },
  "trace_heading_number": {
   "pattern": "^\\s*(\\d+(?:\\.\\d+)*)\\s",
   "flags": 32
  }
 },
