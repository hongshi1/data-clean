 "notes": {
  "A4-leak": "oracle upper bound: identifier_match coincides with the silver label by construction (negatives are ID-disjoint pairs); never the paper main row",
  "paper_main_row": "A4-projection-gate-clean",
  "B1_test_only": "B1 encodes only test-fold texts (scale control, training-free method); threshold calibrated in-fold on test negatives, so its F1/precision/recall/false-merge are optimistic vs other rows; AUC is threshold-free and comparable; IDF df uses test texts + seeded train-text sample",
  "gate_feature_limits": "same_doc is constant-true on this within-doc pair set (constant shift, no ranking effect); same_section=False mapped to unknown, not incompatible, because cross-section coreference is legitimate; same_role/same_scope default unknown — the clean gate carries almost no discriminative signal on this silver data",
  "threshold_protocol": "dev negative-score 95th percentile (B1 exception above)",
  "D_calibration": "temperature scaling is a strictly monotonic remap: ranking metrics are unchanged (AUC identical by construction; F1 identical up to threshold rounding); only ECE/Brier move",
  "C3_boundary_only": "boundary-only variant trains on negative pairs only (margin penalty); positives are unused, so no term pulls similar pairs together",
  "C2_infonce_only": "boundary_weight=0; the dead negative sampling is dropped along with the zero-weight term (identical gradients, faster epochs)",
