    "source": "GJB 438C-2021 4.3",
    "description": "文档格式要求",
    "rules": [
      {
        "rule_id": "GJB-FORMAT-001",
        "category": "文档组成",
        "description": "文档一般由封面、修改页、目录、正文和附录组成",
        "required_components": [
          "封面",
          "修改页",
          "目录",
          "正文",
          "附录"
        ],
        "severity": "HIGH"
      },
      {
        "rule_id": "GJB-FORMAT-002",
        "category": "封面",
        "description": "封面应包括文档号、版本/修订号、密级、文档名称、系统标识、编制单位、编写/审核/会签/批准、日期",
        "required_fields": [
          "文档号",
          "版本/修订号",
          "密级",
          "文档名称",
          "编制单位",
          "日期"
        ],
        "severity": "MEDIUM"
      },
      {
        "rule_id": "GJB-FORMAT-003",
        "category": "修改页",
        "description": "修改页应提供文档的修改历史，包括修改原因、修改内容、修改版本、日期",
        "required_fields": [
          "修改原因",
          "修改内容",
          "修改版本",
          "日期"
        ],
        "severity": "MEDIUM"
      },
      {
        "rule_id": "GJB-FORMAT-004",
        "category": "目录",
        "description": "目录应包括章、条和附录的编号、标题及其所在页码",
        "required_fields": [
          "编号",
          "标题",
          "页码"
        ],
        "severity": "MEDIUM"
      },
      {
        "rule_id": "GJB-FORMAT-005",
        "category": "页号",
        "description": "正文前页使用小写罗马数字编号，正文和附录使用阿拉伯数字编号",
        "rules_detail": {
          "front_matter": "小写罗马数字 (i, ii, iii...)",
          "body": "阿拉伯数字 (1, 2, 3...)",
          "appendix": "阿拉伯数字 (继续编号)"
        },
        "severity": "LOW"
